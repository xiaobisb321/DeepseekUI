    create("TextLabel", { Size = UDim2.new(1, -60, 0, 16), Position = UDim2.new(0, 15, 0, 30), BackgroundTransparency = 1, Text = desc, TextColor3 = C_SUB, TextSize = 11, Font = FONT, TextXAlignment = Enum.TextXAlignment.Left, Parent = card })

    -- 开关按钮
    local tBg = create("Frame", { Size = UDim2.new(0, 34, 0, 18), Position = UDim2.new(1, -50, 0, 15), BackgroundColor3 = C_SUB, BorderSizePixel = 0, Parent = card })
    corner(tBg, 9)
    local dot = create("Frame", { Size = UDim2.new(0, 14, 0, 14), Position = UDim2.new(0, 2, 0.5, -7), BackgroundColor3 = C_WHITE, BorderSizePixel = 0, Parent = tBg })
    corner(dot, 7)
    local toggleBtn = create("TextButton", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", Parent = tBg })

    -- 速度滑块
    local sliderBg = create("Frame", { Size = UDim2.new(1, -30, 0, 4), Position = UDim2.new(0, 15, 0, 62), BackgroundColor3 = Color3.fromRGB(220, 220, 225), BorderSizePixel = 0, Parent = card })
    corner(sliderBg, 2)
    local fill = create("Frame", { Size = UDim2.new(stateRef.speed / 300, 0, 1, 0), BackgroundColor3 = C_BLUE, BorderSizePixel = 0, Parent = sliderBg })
    corner(fill, 2)
    local knob = create("Frame", { Size = UDim2.new(0, 12, 0, 12), Position = UDim2.new(stateRef.speed / 300, -6, 0.5, -6), BackgroundColor3 = C_WHITE, BorderSizePixel = 0, Parent = sliderBg })
    corner(knob, 6)
    create("UIStroke", { Color = C_BLUE, Thickness = 1 }, knob)
    
    local valText = create("TextLabel", { Size = UDim2.new(0, 30, 0, 20), Position = UDim2.new(1, -35, 0, 52), BackgroundTransparency = 1, Text = tostring(stateRef.speed), TextColor3 = C_SUB, TextSize = 11, Font = FONT_BOLD, Parent = card })

    local drag = false
    local function updateSlider(i)
        local ratio = math.clamp((i.Position.X - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X, 0, 1)
        local val = math.floor(16 + (300 - 16) * ratio)
        valText.Text = tostring(val)
        fill.Size = UDim2.new(ratio, 0, 1, 0)
        knob.Position = UDim2.new(ratio, -6, 0.5, -6)
        speedCallback(val)
    end
    sliderBg.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = true; updateSlider(i) end end)
    UIS.InputChanged:Connect(function(i) if drag and i.UserInputType == Enum.UserInputType.MouseMovement then updateSlider(i) end end)
    UIS.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = false end end)

    toggleBtn.MouseButton1Click:Connect(function()
        stateRef.on = not stateRef.on
        tBg.BackgroundColor3 = stateRef.on and C_BLUE or C_SUB
        dot.Position = stateRef.on and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
        toggleCallback(stateRef.on)
    end)
end

-- 实例化功能卡片
createFeatureCard("飞行", "激活飞行模式，点击悬浮窗可开关", States.Fly, 
    function(on) 
        if on then
            local char = lp.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hrp or not hum then return end
            hum.PlatformStand = true
            States.Fly.bv = create("BodyVelocity", { MaxForce = Vector3.new(math.huge, math.huge, math.huge), Velocity = Vector3.new(0,0,0), P = 3000 }, hrp)
            States.Fly.bg = create("BodyGyro", { MaxTorque = Vector3.new(math.huge, math.huge, math.huge), CFrame = hrp.CFrame, P = 9000 }, hrp)
            local cam = workspace.CurrentCamera
            States.Fly.conn = RunService.RenderStepped:Connect(function()
                if not States.Fly.on or not States.Fly.bv or not States.Fly.bg then return end
                if cam then States.Fly.bg.CFrame = cam.CFrame end
                local dir = hum.MoveDirection
                if dir.Magnitude > 0 and cam then
                    local cd = cam.CFrame:VectorToObjectSpace(dir)
                    local wd = (cam.CFrame * CFrame.new(cd.X, 0, cd.Z)).p - cam.CFrame.p
                    States.Fly.bv.Velocity = wd.Unit * States.Fly.speed
                else
                    States.Fly.bv.Velocity = Vector3.new(0,0,0)
                end
                if UIS:IsKeyDown(Enum.KeyCode.Space) then States.Fly.bv.Velocity = States.Fly.bv.Velocity + Vector3.new(0, States.Fly.speed*0.6, 0)
                elseif UIS:IsKeyDown(Enum.KeyCode.LeftShift) then States.Fly.bv.Velocity = States.Fly.bv.Velocity + Vector3.new(0, -States.Fly.speed*0.6, 0) end
            end)
        else
            if States.Fly.bv then States.Fly.bv:Destroy(); States.Fly.bv = nil end
            if States.Fly.bg then States.Fly.bg:Destroy(); States.Fly.bg = nil end
            if States.Fly.conn then States.Fly.conn:Disconnect(); States.Fly.conn = nil end
            local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum.PlatformStand = false end
        end
    end, 
    function(val) States.Fly.speed = val end
)

