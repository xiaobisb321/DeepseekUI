local function createFeatureCard(title, desc, stateRef, toggleCallback, speedCallback)
    local card = create("Frame", { Size = UDim2.new(1, -10, 0, 80), BackgroundColor3 = C_BG, BackgroundTransparency = 0.1, BorderSizePixel = 0, Parent = cardList })
    corner(card, 8)
    
