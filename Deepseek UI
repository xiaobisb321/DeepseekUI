local function createHUD(title, stateRef, toggleCallback)
    local hud = create("Frame", { Size = UDim2.new(0, 100, 0, 32), Position = UDim2.new(0, 20, 0.5, 20), BackgroundColor3 = C_WHITE, BackgroundTransparency = 0.1, BorderSizePixel = 0, Parent = gui })
    corner(hud, 16)
    local stroke = create("UIStroke", { Color = C_BLUE, Thickness = 1.5, Transparency = 0.5 }, hud)
    
    local icon = create("ImageLabel", { Size = UDim2.new(0, 16, 0, 16), Position = UDim2.new(0, 10, 0.5, -8), BackgroundTransparency = 1, Image = ICON_WHALE, ImageColor3 = C_SUB, Parent = hud })
    local txt = create("TextLabel", { Size = UDim2.new(1, -30, 1, 0), Position = UDim2.new(0, 30, 0, 0), BackgroundTransparency = 1, Text = title, TextColor3 = C_TEXT, TextSize = 11, Font = FONT_BOLD, TextXAlignment = Enum.TextXAlignment.Left, Parent = hud })
    
    stateRef.hud = hud
    stateRef.hud.Icon = icon

    local drag, dragStart, startPos, moved = false, nil, nil, false
    local pressTime = 0
    local lastClick = 0
    local locked = false

    hud.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            drag = true
            dragStart = i.Position
            startPos = hud.Position
            moved = false
            pressTime = tick()

            local now = tick()
            if now - lastClick < 0.3 then
                locked = not locked
                stroke.Color = locked and C_SUB or C_BLUE
                txt.Text = title .. (locked and " [锁]" or "")
            end
            lastClick = now
        end
    end)

    UIS.InputChanged:Connect(function(i)
        if drag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - dragStart
            if math.abs(d.X) > 3 or math.abs(d.Y) > 3 then
                moved = true
            end
            if not locked and moved then
                hud.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end
    end)

    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            if drag then
                drag = false
                if not moved and (tick() - pressTime) < 0.25 then
                    toggleCallback(not stateRef.on)
                end
            end
        end
    end)

    return hud
end

