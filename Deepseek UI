local function createHUD(title, stateRef, toggleCallback)
    local hud = create("Frame", { Size = UDim2.new(0, 110, 0, 36), Position = UDim2.new(0, 20, 0.5, 20), BackgroundColor3 = C_WHITE, BackgroundTransparency = 0.1, BorderSizePixel = 0, Visible = false, Parent = gui })
    corner(hud, 18)
    create("UIStroke", { Color = C_BLUE, Thickness = 1.5, Transparency = 0.5 }, hud)
    
    local icon = create("ImageLabel", { Size = UDim2.new(0, 20, 0, 20), Position = UDim2.new(0, 8, 0.5, -10), BackgroundTransparency = 1, Image = ICON_WHALE, ImageColor3 = C_BLUE, Parent = hud })
    local txt = create("TextLabel", { Size = UDim2.new(1, -30, 1, 0), Position = UDim2.new(0, 30, 0, 0), BackgroundTransparency = 1, Text = title, TextColor3 = C_TEXT, TextSize = 12, Font = FONT_BOLD, TextXAlignment = Enum.TextXAlignment.Left, Parent = hud })
    
    -- 拖拽逻辑
    local dragging, dragStart, startPos
    local function startDrag(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = i.Position; startPos = hud.Position
        end
    end
    hud.InputBegan:Connect(startDrag)
    UIS.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - dragStart
            hud.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    -- 双击固定/解锁
    local lastClick = 0
    hud.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            local now = tick()
            if now - lastClick < 0.3 then
                stateRef.hudLocked = not stateRef.hudLocked
                hud.BackgroundTransparency = stateRef.hudLocked and 0.1 or 0.4
                txt.Text = title .. (stateRef.hudLocked and " 🔒" or "")
            end
            lastClick = now
        end
    end)

    -- 点击开关功能 (短按)
    local pressTime = 0
    hud.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then pressTime = tick() end end)
    hud.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            if tick() - pressTime < 0.2 and not dragging then
                stateRef.on = not stateRef.on
                toggleCallback(stateRef.on)
                txt.TextColor3 = stateRef.on and C_BLUE or C_SUB
            end
        end
    end)

    return hud
end

